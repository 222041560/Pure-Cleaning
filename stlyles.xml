/* =========================================
   PURELY CLEANING SERVICES
   MAIN STYLES
========================================= */


/* ---------- BASIC RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8f3e9;
    color: #0b2a52;
    line-height: 1.6;
}


a {
    text-decoration: none;
    color: inherit;
}


.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}



/* =========================================
   HEADER
========================================= */

.header {
    background: #ffffff;
    border-bottom: 2px solid #c9972b;
    position: sticky;
    top: 0;
    z-index: 1000;
}


.nav-container {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}


.logo {
    display: flex;
    flex-direction: column;
}


.logo-main {
    font-family: Georgia, serif;
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 7px;
}


.logo-sub {
    color: #b27b13;
    font-size: 11px;
    letter-spacing: 3px;
    font-weight: bold;
}


.nav {
    display: flex;
    align-items: center;
    gap: 28px;
}


.nav a {
    font-weight: bold;
    transition: 0.3s;
}


.nav a:hover {
    color: #b27b13;
}


.nav-button {
    background: #0b2a52;
    color: white !important;
    padding: 12px 20px;
    border-radius: 30px;
}


.menu-btn {
    display: none;
    border: none;
    background: #0b2a52;
    color: white;
    font-size: 25px;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
}



/* =========================================
   HERO
========================================= */

.hero {
    background:
        linear-gradient(
            135deg,
            #f8f3e9 0%,
            #fffdf8 60%,
            #ead9ad 100%
        );

    padding: 100px 0;
    border-bottom: 5px solid #c9972b;
}


.hero-content {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 70px;
    align-items: center;
}


.small-title {
    color: #b27b13;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 15px;
}


.hero h1 {
    font-family: Georgia, serif;
    font-size: 65px;
    line-height: 1.05;
    margin-bottom: 25px;
}


.hero h1 span {
    display: block;
    color: #b27b13;
}


.hero-description {
    font-size: 20px;
    max-width: 600px;
    margin-bottom: 30px;
}


.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}


.button {
    display: inline-block;
    padding: 15px 25px;
    border-radius: 30px;
    font-weight: bold;
    transition: 0.3s;
}


.primary {
    background: #0b2a52;
    color: white;
}


.primary:hover {
    background: #123d70;
    transform: translateY(-3px);
}


.secondary {
    border: 2px solid #0b2a52;
}


.secondary:hover {
    background: #0b2a52;
    color: white;
}


.hero-card {
    background: #0b2a52;
    color: white;
    padding: 60px 35px;
    border-radius: 100px 25px 100px 25px;
    text-align: center;
    border: 4px solid #c9972b;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
}


.hero-icon {
    font-size: 50px;
    color: #d6a638;
    margin-bottom: 15px;
}


.hero-card h2 {
    font-family: Georgia, serif;
    letter-spacing: 2px;
}


.hero-card h3 {
    color: #d6a638;
    margin-top: 10px;
    letter-spacing: 2px;
}


.hero-card p {
    margin-top: 25px;
}


.gold-line {
    width: 80px;
    height: 2px;
    background: #d6a638;
    margin: 20px auto;
}



/* =========================================
   SECTION HEADING
========================================= */

.section-heading {
    text-align: center;
    margin-bottom: 55px;
}


.section-heading p,
.section-label {
    color: #b27b13;
    font-weight: bold;
    letter-spacing: 3px;
}


.section-heading h2 {
    font-family: Georgia, serif;
    font-size: 45px;
    margin: 8px 0;
}


.section-heading span {
    display: block;
    max-width: 650px;
    margin: 15px auto 0;
}


.heading-line {
    width: 100px;
    height: 3px;
    background: #c9972b;
    margin: 15px auto;
}



/* =========================================
   SERVICES
========================================= */

.services {
    padding: 100px 0;
    background: #ffffff;
}


.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}


.service-card {
    background: #f8f3e9;
    padding: 35px 25px;
    border-radius: 15px;
    border: 1px solid #e0c47d;
    transition: 0.3s;
}


.service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
}


.service-icon {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #0b2a52;
    color: #d6a638;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 20px;
    border: 3px solid #d6a638;
}


.service-card h3 {
    font-family: Georgia, serif;
    font-size: 22px;
    margin-bottom: 10px;
}


.service-card p {
    color: #555;
}



/* =========================================
   ABOUT
========================================= */

.about {
    padding: 100px 0;
    background: #0b2a52;
    color: white;
}


.about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}


.about h2 {
    font-family: Georgia, serif;
    font-size: 48px;
    margin: 10px 0 25px;
}


.about-text p:not(.section-label) {
    color: #e8edf4;
    margin-bottom: 20px;
}


.features {
    display: grid;
    gap: 20px;
}


.feature {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border-bottom: 1px solid rgba(214, 166, 56, 0.5);
}


.feature-icon {
    width: 55px;
    height: 55px;
    min-width: 55px;
    border-radius: 50%;
    border: 2px solid #d6a638;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d6a638;
    font-size: 22px;
}


.feature h3 {
    color: #d6a638;
}


.feature p {
    color: #e1e6ed;
}



/* =========================================
   CTA
========================================= */

.cta {
    background: #c9972b;
    padding: 55px 0;
}


.cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}


.cta p {
    font-weight: bold;
    letter-spacing: 3px;
}


.cta h2 {
    font-family: Georgia, serif;
    font-size: 40px;
}


.white-button {
    background: white;
    color: #0b2a52;
}


.white-button:hover {
    transform: scale(1.05);
}



/* =========================================
   CONTACT
========================================= */

.contact {
    padding: 100px 0;
    background: #f8f3e9;
}


.contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}


.contact-card {
    background: white;
    text-align: center;
    padding: 40px 25px;
    border-radius: 15px;
    border: 1px solid #e0c47d;
}


.contact-icon {
    font-size: 35px;
    margin-bottom: 15px;
}


.contact-card h3 {
    margin-bottom: 10px;
    font-family: Georgia, serif;
}


.contact-card a {
    color: #b27b13;
    font-weight: bold;
}



/* =========================================
   FOOTER
========================================= */

.footer {
    background: #071d39;
    color: white;
}


.footer-content {
    padding: 50px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    align-items: center;
}


.footer h2 {
    font-family: Georgia, serif;
    letter-spacing: 5px;
}


.footer p {
    color: #dfe5ec;
}


.footer a {
    color: #d6a638;
    font-weight: bold;
}


.copyright {
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.2);
    padding: 20px;
}



/* =========================================
   WHATSAPP BUTTON
========================================= */

.whatsapp {
    position: fixed;
    right: 25px;
    bottom: 25px;

    width: 60px;
    height: 60px;

    border-radius: 50%;

    background: #25D366;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 30px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.3);

    z-index: 2000;
}


.whatsapp:hover {
    transform: scale(1.1);
}



/* =========================================
   MOBILE RESPONSIVE
========================================= */

@media (max-width: 900px) {

    .nav {
        position: absolute;
        top: 80px;
        left: 0;

        width: 100%;

        background: white;

        flex-direction: column;

        padding: 25px;

        display: none;

        border-bottom: 2px solid #c9972b;
    }


    .nav.active {
        display: flex;
    }


    .menu-btn {
        display: block;
    }


    .hero-content {
        grid-template-columns: 1fr;
    }


    .hero h1 {
        font-size: 48px;
    }


    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }


    .about-container {
        grid-template-columns: 1fr;
    }


    .contact-grid {
        grid-template-columns: 1fr;
    }


    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

}



@media (max-width: 600px) {

    .hero {
        padding: 70px 0;
    }


    .hero h1 {
        font-size: 40px;
    }


    .hero-description {
        font-size: 17px;
    }


    .services-grid {
        grid-template-columns: 1fr;
    }


    .section-heading h2 {
        font-size: 35px;
    }


    .about h2 {
        font-size: 38px;
    }


    .cta-content {
        flex-direction: column;
        text-align: center;
    }


    .hero-card {
        border-radius: 50px 15px 50px 15px;
    }


    .whatsapp {
        width: 55px;
        height: 55px;
        right: 18px;
        bottom: 18px;
    }

}
